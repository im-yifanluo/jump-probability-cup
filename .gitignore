.env
.venv/
__pycache__/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# regenerable or runtime data (data/models and data/inputs are tracked)
/data/raw/
/data/cache/
/data/logs/
/data/exports/

# Claude Code scheduler runtime state
.claude/scheduled_tasks.lock

# LaTeX build files (paper/report.pdf itself is committed)
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.synctex.gz
/paper/*.toc
